<?xml version="1.0" encoding="utf-8"?>
<!--
==============================================================================
FinTrack Android Mobile Companion — Manifest Configuration
==============================================================================
Declares the SMS_RECEIVED system broadcast permission and registers the
SmsBroadcastReceiver component with high priority to capture bank transaction alerts.
==============================================================================
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.fintrack.companion">

    <!-- Permissions required to receive and intercept bank alerts -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <application
        android:allowBackup="false"
        android:label="FinTrack Mobile Forwarder"
        android:theme="@android:style/Theme.NoDisplay">

        <!-- 
            BroadcastReceiver Component:
            Listens for the system-wide android.provider.Telephony.SMS_RECEIVED intent.
            Temporarily woken up by the Android OS the instant an SMS arrives.
        -->
        <receiver
            android:name=".SmsBroadcastReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
